# Optional overrides; defaults are resolved relative to this repository.
# DATABASE_URL=sqlite:///C:/path/to/unreleased/backend/music.db
# UPLOADS_DIR=C:/path/to/unreleased/uploads
# MAX_UPLOAD_BYTES=262144000
# MAX_COVER_BYTES=10485760
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Set true behind HTTPS; false is only for local HTTP development.
COOKIE_SECURE=false
SESSION_DAYS=7
REGISTRATION_ENABLED=true
